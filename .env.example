APP_NAME=DocGuard AI
APP_ENV=development
DEBUG=true

POSTGRES_USER=docguard
POSTGRES_PASSWORD=docguard
POSTGRES_DB=docguard
DATABASE_URL=postgresql+psycopg://docguard:docguard@postgres:5432/docguard

REDIS_URL=redis://redis:6379/0

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TEXT_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=qwen2.5vl:3b

UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=20
